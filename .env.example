# 後端監聽的連接埠。沒設就用 3000。
PORT=3000

# 對外公開的網址，QR Code 與房間連結用它。手機要連得到才行，所以區網測試請填電腦的區網 IP，
# 不要填 localhost。沒設就用主持人瀏覽器網址列的網址。
PUBLIC_BASE_URL=http://localhost:3000

# 遊戲事件紀錄（SQLite）的檔案路徑。沒設就用 ./data/events.db，資料夾不存在會自動建立。
LOG_DB_PATH=./data/events.db

# GET /admin/games/:gameId/events 要帶 Authorization: Bearer <這個值>。
# 不設定的話這個端點整個停用（回 404）。部署時請換成自己的隨機字串。
ADMIN_TOKEN=change-me
