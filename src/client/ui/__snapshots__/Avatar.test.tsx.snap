exports[`Avatar > eliminated and offline: shows both overlays 1`] = `"<div class="wd-avatar" data-pattern="3" data-offline="true" data-eliminated="true" style="--avatar-color: #e63946;"><div class="wd-avatar__badge" role="img" aria-label="小明，已淘汰，離線"><img alt="" draggable="false" src="data:image/svg+xml,%3csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3e%3cpath%20d='M32%205%2059%2033%2032%2061%205%2033Z'%20fill='%23fffdf5'%20stroke='%231f1b3a'%20stroke-width='3'%20stroke-linejoin='round'%20stroke-linecap='round'/%3e%3cpath%20d='M21%2031h8M35%2031h8'%20stroke='%231f1b3a'%20stroke-width='3'%20stroke-linejoin='round'%20stroke-linecap='round'/%3e%3cpath%20d='M27%2041q5%20-3%2010%200'%20stroke='%231f1b3a'%20stroke-width='3'%20stroke-linejoin='round'%20stroke-linecap='round'%20fill='none'/%3e%3c/svg%3e"></div><span class="wd-avatar__name">小明</span><span class="wd-avatar__tag" data-tag="eliminated">已淘汰</span><span class="wd-avatar__tag">離線</span></div>"`;

